{% extends 'base.html.twig' %}

{% block body %}
<section class="admin p-3">
    {% include 'common/_breadcrumb.html.twig' %}
    <h1 class="mb-4">
        Documents<i class="bi bi-trash"></i>
        <a href="{{ path('app_admin_edit_document') }}" class="pointer" title="Ajouter un document">+</a>
    </h1>

    <div class="mb-3">
    {{ form_start(form) }}
        {{ form_widget(form.keywords, {attr: {class: 'form-control'}}) }}
        <button type="submit" class="d-none"></button>
    {{ form_end(form) }}
    </div>

    {% include 'common/_flash_message.html.twig' %}
    <table class="table table-striped mt-2">
        <thead class="table-primary">
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Titre</th>
                <th scope="col">Créée</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for doc in docs %}
            <tr>
                <th scope="row">{{ doc.id }}</th>
                <td>{{ doc.title }}</td>
                <td>{{ doc.createdAt|date('d/m/Y') }}</td>
                <td>
                    <a class="btn btn-sm btn-outline-info me-2" href="{{ path('app_admin_edit_document', {id: doc.id}) }}">Modifier</a>
                    <a class="btn btn-sm btn-outline-danger delete-doc" href="{{ path('app_admin_delete_document',  {id: doc.id, _token: csrf_token('delete' ~ doc.id)}) }}">Supprimer</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="mt-3">
        {{ knp_pagination_render(docs) }}
    </div>
</section>
{% endblock %}
{% block importmap %}
    {{ importmap(['app', 'doc']) }}
{% endblock %}
