{% extends 'base.html.twig' %}

{% block body %}
<section class="admin p-3">
    <h1 class="mb-4">
        Documents
        <a href="" class="pointer">+</a>
    </h1>

    <table class="table table-striped">
        <thead class="table-primary">
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Titre</th>
                <th scope="col">Créée</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for doc in docs %}
            <tr>
                <th scope="row">{{ doc.id }}</th>
                <td>{{ doc.title }}</td>
                <td>{{ doc.createdAt|date('d/m/Y') }}</td>
                <td>
                    <a class="btn btn-sm btn-outline-info me-2">Modifier</a>
                    <a class="btn btn-sm btn-outline-danger">Supprimer</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="mt-3">
        {{ knp_pagination_render(docs) }}
    </div>
</section>
{% endblock %}
