{% extends 'base.html.twig' %}

{% block body %}
<section class="admin p-3">
    {% include 'common/_breadcrumb.html.twig' with {'pages': [
        { name: 'Documents', link: app.session.get('app_admin_documents_url')|default(path('app_admin_documents')) }
    ]} %}
    <h1 class="mb-4">
        {% if doc.createdAt is null %}
        Ajouter un document
        {% else %}
        Modifier le document: {{ doc.title }}
        {% endif %}
    </h1>

    {{ form_start(form) }}
    <div class="mb-3">
        {{ form_label(form.title, 'Titre *', {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.title, {attr: {class: 'form-control'}}) }}
        {% for error in form.title.vars.errors %}
            <div class="alert alert-danger mt-2">{{ error.message }}</div>
        {% endfor %}
    </div>
    <div class="mb-3">
        {{ form_label(form.content, 'Contenu *', {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.content, {attr: {class: 'ckeditor form-control'}}) }}
        {% for error in form.content.vars.errors %}
            <div class="alert alert-danger mt-2">{{ error.message }}</div>
        {% endfor %}
    </div>

    {% include 'common/_flash_message.html.twig' %}

    <div class="d-flex justify-content-between">
       <button type="submit" class="btn btn-primary">Envoyer</button>
       <a class="btn btn-outline-dark" href="{{ app.session.get('app_admin_documents_url')|default(path('app_admin_documents')) }}">Retour</a>
    </div>
    
    {{ form_end(form) }}
    
</section>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/ckeditor/ckeditor.js') }}"></script>
{% endblock %}