{% extends 'base.html.twig' %}

{% block body %}
{% import 'common/_macros.html.twig' as util %}

<section class="admin p-3" id="video">
{% include 'common/_breadcrumb.html.twig' %}
    <h1 class="mb-4">
        Vidéos
        <a href="{{ path('app_admin_edit_video') }}" class="pointer" title="Ajouter une vidéo">+</a>
        <a class="pointer btn-filter-form" title="filtres">
            <i class="bi bi-filter-square fs-4"></i>
        </a>
    </h1>

    <section class="p-3 wrap-filter-form mb-3 {% if openedForm is same as (false) %}d-none{% endif %}">
    {{ form_start(form) }}
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_label(form.keywords) }}
                    {{ form_widget(form.keywords, {'attr': {'placeholder': 'Rechercher par titre ou description'}}) }}
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_label(form.website) }}
                    {{ form_widget(form.website) }}
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_label(form.actress) }}
                    {{ form_widget(form.actress) }}
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_label(form.videoType) }}
                    {{ form_widget(form.videoType) }}
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">Envoyer</button>
                </div>
            </div>
        </div>
    {{ form_end(form) }}
    </section>

    {% include 'common/_flash_message.html.twig' %}

    <table class="table table-striped mt-2">
        <thead class="table-primary">
            <tr>
                <th scope="col">
                    {{ knp_pagination_sortable(videos, 'Titre', 'video.title') }}
                </th>
                <th scope="col">Photo</th>
                <th scope="col">
                    {{ knp_pagination_sortable(videos, 'Actrice', 'actress.name') }}
                </th>
                <th scope="col">
                    {{ knp_pagination_sortable(videos, 'Type', 'video.videoType') }}
                </th>
                <th scope="col">Visible</th>
                <th scope="col">
                    {{ knp_pagination_sortable(videos, 'Ajoutée', 'video.createdAt') }}
                </th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for video in videos %}
            <tr>
                <th scope="row">{{ video.title }}</th>
                <td>
                {% if video.photo is not null %}
                    <img class="profile-photo" src="{{ util.media_url(video.photo.name) }}" alt="">
                {% endif %}
                </td>
                <td>{{ video.actress.name }}</td>
                <td>{{ video.videoType.value }}</td>
                <td>
                </td>
                <td>{{ video.createdAt|date('d/m/Y') }}</td>
                <td>
                    <a class="btn btn-sm btn-outline-info me-2 mb-2" href="{{ path('app_admin_edit_video', {id: video.id}) }}">Modifier</a>
                    <a class="btn btn-sm btn-danger me-2 mb-2 delete-video" href="{{ path('app_admin_delete_video', {id: video.id, _token: csrf_token('delete' ~ video.id)}) }}">Supprimer</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="mt-3">
        {{ knp_pagination_render(videos) }}
    </div>
</section>
{% endblock %}
{% block importmap %}
    {{ importmap(['app', 'video']) }}
{% endblock %}
