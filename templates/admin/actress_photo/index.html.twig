{% extends 'base.html.twig' %}

{% block body %}
{% import 'common/_macros.html.twig' as util %}

<section class="admin p-3" id="actress-photo">
    {% include 'common/_breadcrumb.html.twig' %}
    <h1 class="mb-4">
        Photos
        <a href="{{ path('app_admin_add_actress_photos') }}" class="pointer" title="Ajouter une photo">+</a>
        <a class="pointer btn-filter-form" title="filtres">
            <i class="bi bi-filter-square fs-4"></i>
        </a>
    </h1>

    {% include 'common/_flash_message.html.twig' %}
    <div class="container-fluid">
        <div class="row">
        {% for actress_photo in actressePhotos %}
            <div class="col-6 col-md-4 col-lg-2 mb-5">
                <div class="wrap-photo">
                    <h5 class="text-center mb-1">{{ actress_photo.actress.name }}</h5>
                    <div class="d-flex justify-content-between mb-1">
                        <a class="fs-4 pointer" title="Modifier une photo">
                            <i class="bi bi-pencil-fill"></i>
                        </a>
                        <a class="fs-4 pointer text-danger delete-actress-photo" title="Supprimer une photo" href="{{ path('app_admin_delete_actress_photo',  {id: actress_photo.id, _token: csrf_token('delete' ~ actress_photo.id)}) }}">
                            <i class="bi bi-trash-fill"></i>
                        </a>
                    </div>
                    <img src="{{ util.media_url(actress_photo.photo.name) }}" alt="">
                </div>
            </div>
        {% endfor %}
        </div>
    </div>
</section>
{% endblock %}
{% block importmap %}
    {{ importmap(['app', 'actress_photo']) }}
{% endblock %}