{% extends 'base.html.twig' %}

{% block body %}
{% import 'common/_macros.html.twig' as util %}

<section class="admin p-3">
    {% include 'common/_breadcrumb.html.twig' %}
    <h1 class="mb-4">
        Actrices
        <a href="{{ path('app_admin_edit_actress') }}" class="pointer" title="Ajouter une actrice">+</a>
        <a class="pointer btn-filter-form" title="filtres">
            <i class="bi bi-filter-square fs-4"></i>
        </a>
    </h1>

    <section class="p-3 wrap-filter-form mb-3 d-none">
        {{ form_start(form) }}
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.keywords) }}
                        {{ form_widget(form.keywords) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.country) }}
                        {{ form_widget(form.country) }}
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Envoyer</button>
                    </div>
                </div>
            </div>
        {{ form_end(form) }}
    </section>

    {% include 'common/_flash_message.html.twig' %}
    <table class="table table-striped mt-2">
        <thead class="table-primary">
            <tr>
                <th scope="col">
                    {{ knp_pagination_sortable(actresses, 'Nom', 'actress.name') }}
                </th>
                <th scope="col">Photo</th>
                <th scope="col">
                    {{ knp_pagination_sortable(actresses, 'Pays', 'actress.country') }}
                </th>
                <th scope="col">
                    {{ knp_pagination_sortable(actresses, 'Née', 'actress.birthday') }}
                </th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for actress in actresses %}
            <tr>
                <th scope="row">{{ actress.name }}</th>
                <td>
                {% if actress.photo is not null %}
                    <img class="profile-photo" src="{{ util.media_url(actress.photo.name) }}" alt="">
                {% endif %}
                </td>
                <td>{{ actress.country }}</td>
                <td>{{ actress.birthday|date('d/m/Y') }}</td>
                <td>
                    <a class="btn btn-sm btn-outline-info me-2" href="{{ path('app_admin_edit_actress', {id: actress.id}) }}">Modifier</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="mt-3">
        {{ knp_pagination_render(actresses) }}
    </div>
</section>
{% endblock %}
{% block importmap %}
    {{ importmap(['app', 'actress']) }}
{% endblock %}
