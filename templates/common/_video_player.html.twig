<section id="video-player">
    <div class="wrap-btns d-none text-end pe-2 pt-1 pb-1">
        <a title="Recharger le lecteur" class="ms-2 pointer reload-video-player text-white fs-3">
            <i class="bi bi-arrow-clockwise"></i>
        </a>
        <a title="Réduire le lecteur" class="ms-2 pointer toggle-video-player-fullscreen text-white fs-3">
            <i class="bi bi-fullscreen-exit"></i>
        </a>
    </div>
    <div id="wrap-iframe" class="mt-2">
        <iframe 
            id="player" 
            src="{{ zhen_front_service }}/video-player"   
            style="width:100%;border: none;"
            allowfullscreen
        ></iframe>
    </div>
    <div class="d-none">
        {# <input id="s3-url" value="{{ s3_url }}" />
        <input id="s3-root-audio" value="{{ s3_root_audio }}" /> #}
        <input id="front-service-url" value="{{ zhen_front_service }}" />
    </div>
</section>