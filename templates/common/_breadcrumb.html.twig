<div id="breadcrumb" class="mb-3">
    <a href="{{ path('app_home') }}">Accueil</a>
    <i class="bi bi-chevron-right"></i>
    {% if pages is defined %}
        {% for page in pages %}
            <a href="{{ page.link }}">{{ page.name }}</a>
            <i class="bi bi-chevron-right"></i>
        {% endfor %}
    {% endif %}
</div>