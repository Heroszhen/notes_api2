{% extends 'base.html.twig' %}

{% block body %}
<section class="pt-5 pb-2"> 
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-10 col-lg-7 mb-3">
                <h1 class="mb-5">{{ doc.title }}</h1>
                <section class="word-wrap">{{ doc.content|raw }}</section>
                <small class="text-secondary">{{ doc.createdAt|date('d/m/Y H:i:s') }}</small>
            </div>
        </div>
    </div>
</section>
{% endblock %}
