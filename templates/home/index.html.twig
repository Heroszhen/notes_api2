{% extends 'base.html.twig' %}

{% block body %}
<section class="pt-5 pb-2" id="home"> 
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-10 col-lg-7 mb-3">
                {{ form_start(form) }}
                    {{ form_widget(form.keywords, {attr: {class: 'form-control'}}) }}
                    <button type="submit" class="d-none"></button>
                {{ form_end(form) }}
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-md-10 col-lg-7">
            {% for doc in docs %}
                <article class="mb-4 border-bottom pb-4 word-wrap">
                    <a href="{{ path('app_document', {id: doc.id}) }}" class="text-dark">
                        <h2>{{ doc.title }}</h2>
                        <div>{{ doc.content|striptags|slice(0, 100) }}...</div>
                        <small class="text-secondary">{{ doc.createdAt|date('d/m/Y') }}</small>
                    </a>
                </article>
            {% endfor %}
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-md-10 col-lg-7 mt-3">
                {{ knp_pagination_render(docs) }}
            </div>
        </div>
    </div>
</section>
{% endblock %}
{% block importmap %}
    {{ importmap(['app', 'doc']) }}
{% endblock %}
